# Todoist personal API token (Settings -> Integrations -> Developer).
# NOTE: this token is ALWAYS full read+write, account-wide. Todoist has no
# local read-only token tier. See README "Credential constraint".
# Do NOT commit a real value. In deployment this is read from the environment,
# typically sourced from a 0600 file in a 0700 dir owned by the service account
# running this process.
TODOIST_API_KEY=

# Read-only mode. Read at process startup ONLY; never a runtime toggle.
#   unset            -> read-only (fail-safe default)
#   "false"          -> writes ENABLED (full tool set registered)
#   any other value  -> read-only
TODOIST_READONLY=

# Injection / flood mitigations (optional; sane defaults applied if unset).
# Max characters returned by any single read tool (total output-size cap).
TODOIST_MAX_OUTPUT_CHARS=50000
# Max characters kept per individual untrusted text field before truncation.
TODOIST_MAX_FIELD_CHARS=2000
# Max items fetched across pagination for a single read call.
TODOIST_MAX_ITEMS=200
