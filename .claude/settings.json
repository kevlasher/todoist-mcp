{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/test-on-src-or-test-edit.sh\"",
            "timeout": 60,
            "statusMessage": "Running npm test (src/ or test/ edited)..."
          }
        ]
      }
    ]
  },
  "attribution": {
    "sessionUrl": false
  }
}
